# Notion Integration (optional — local Markdown posts still build without these)
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=429080be0cbe4a228dcda78f141a1282

# Auto-redeploy after Notion publish (optional)
# 1) Vercel → Settings → Git → Deploy Hooks → Create Hook → copy URL
# 2) Pick a long random string for REDEPLOY_SECRET
# 3) Notion automation POSTs to https://YOUR_DOMAIN/api/redeploy?secret=...
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxxx/yyyy
REDEPLOY_SECRET=change-me-to-a-long-random-string
